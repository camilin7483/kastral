# === CONFIGURACIÓN LOCAL DE KASTRAL ===
# La mayoría de las herramientas se ejecutan en el navegador. Las que dependen de
# motores nativos (Sharp, Ghostscript, FFmpeg) requieren ejecutar el servidor de Next.js.
# No se necesitan API keys ni cuentas externas.

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DISABLE_ADS="true"

# Buzón que recibe los mensajes del formulario de contacto (se abre el cliente de correo del usuario)
NEXT_PUBLIC_CONTACT_EMAIL="cuentacamilo48@gmail.com"

# Límites del motor de servidor
MAX_FILE_SIZE_MB="50"
MAX_CONCURRENT_TASKS="2"
TASK_TIMEOUT_SECONDS="60"
TEMP_CLEANUP_MINUTES="15"
