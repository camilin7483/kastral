{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kastral",
  "version": "0.2.0",
  "identifier": "com.kastral.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bun run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Kastral",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Kastral",
    "shortDescription": "Convierte, comprime y optimiza archivos gratis y sin conexión.",
    "longDescription": "Kastral convierte y comprime imágenes, PDF, documentos, audio, vídeo y ZIP gratis, con procesamiento local en tu equipo.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons-src/nsis-header.bmp",
        "sidebarImage": "icons-src/nsis-sidebar.bmp",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "startMenuFolder": "Kastral",
        "compression": "lzma"
      }
    }
  }
}
